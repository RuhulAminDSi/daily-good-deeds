{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "env": ["NODE_ENV"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build", "db:generate"],
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_DIRECT_URL", "CI"]
    },
    "check": {},
    "e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "db:generate"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    }
  }
}
