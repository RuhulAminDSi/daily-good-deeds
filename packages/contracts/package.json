{
  "name": "@dgd/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Hand-written API contract shared by the API and its clients: Zod schemas and the error catalog",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dgd/config": "workspace:*",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
