# Copy to .env (local dev) and .env.test (integration tests). Both are git-ignored.
# Neon project "daily-good-deeds": use the `dev` branch for .env and the `test` branch for .env.test.
#   npx neonctl connection-string <branch> --database-name dgd --pooled   -> DATABASE_URL
#   npx neonctl connection-string <branch> --database-name dgd            -> DIRECT_URL

# Pooled connection used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/dgd?sslmode=verify-full
# Direct connection used by Prisma CLI (migrations); bypasses the pooler.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/dgd?sslmode=verify-full

# Optional (defaults shown)
# NODE_ENV=development
# PORT=4000
# LOG_LEVEL=info
# DB_POOL_MAX=5
# Production: comma-separated web origins allowed by CORS (dev defaults to localhost:3000,3210).
# WEB_ORIGINS=https://app.example.com
# Production (required): reverse-proxy hops in front of the API, so rate limiting sees client IPs.
# TRUST_PROXY=1
