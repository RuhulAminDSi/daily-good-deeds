# Copy to .env (local dev) and .env.test (integration tests). Both are git-ignored.
# Neon project "daily-good-deeds": use the `dev` branch for .env and the `test` branch for .env.test.
#   npx neonctl connection-string <branch> --database-name dgd --pooled   -> DATABASE_URL
#   npx neonctl connection-string <branch> --database-name dgd            -> DIRECT_URL

# Pooled connection used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/dgd?sslmode=require
# Direct connection used by Prisma CLI (migrations); bypasses the pooler.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/dgd?sslmode=require

# Optional (defaults shown)
# NODE_ENV=development
# PORT=4000
# LOG_LEVEL=info
# DB_POOL_MAX=5
