{
  "name": "@dgd/api",
  "version": "0.0.0",
  "private": true,
  "description": "Daily Good Deeds REST API (NestJS modular monolith)",
  "type": "module",
  "scripts": {
    "build": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env dist/database/seed.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "nestjs-pino": "5.3.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dgd/config": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
