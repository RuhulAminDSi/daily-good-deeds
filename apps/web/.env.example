# Copy to .env.local for local overrides (git-ignored). All optional in development.

# Server-side base URL of the API (required in production).
# API_URL=http://localhost:4000

# Error reporting (docs/architecture/OBSERVABILITY.md). Inlined into the browser bundle at build
# time; unset → errors are not reported and the Sentry SDK is never downloaded.
# NEXT_PUBLIC_SENTRY_DSN=https://KEY@oORG.ingest.sentry.io/PROJECT
# NEXT_PUBLIC_APP_RELEASE=dev   # the deploy pipeline sets the git SHA
